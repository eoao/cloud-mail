# Copy to .dev.vars. Never commit the real file.
# Generate separate random values; do not reuse secrets.
jwt_secret="replace-with-at-least-32-random-characters"
init_secret="replace-with-a-different-32-character-secret"
resend_webhook_secret="whsec_replace-me"
linuxdo_client_secret="replace-me"

# Optional CF Mail Push Gateway. Leave blank to disable remote push for this CloudMail server.
# The self-hosted CloudMail server never needs APNs keys or device tokens.
# Optional. Omit to use the official CF MAIL gateway automatically.
# Set to "disabled" to turn remote CloudMail push off.
cfmail_push_gateway_url="https://push.readori.com"

# Optional Turnstile response constraints
turnstile_hostnames="localhost"
turnstile_action=""
