{
  "name": "mail-worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --config wrangler-dev.toml",
    "test": "wrangler deploy --config wrangler-test.toml",
    "deploy": "wrangler deploy",
    "start": "wrangler dev",
    "security:test": "node --experimental-default-type=module scripts/security-smoke-test.mjs",
    "security:migration-test": "python3 scripts/security-migration-test.py && python3 scripts/push-gateway-migration-test.py",
    "email:list:test": "node --experimental-default-type=module scripts/email-list-contract-test.mjs",
    "telegram:test": "node --experimental-default-type=module scripts/telegram-forward-contract-test.mjs",
    "push:contract-test": "node scripts/push-webhook-contract-test.mjs",
    "rich-email:test": "node scripts/rich-email-sanitizer-contract-test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.7.5",
    "vitest": "~3.0.7",
    "wrangler": "^4.90.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.882.0",
    "@cloudflare/vite-plugin": "1.6.0",
    "dayjs": "^1.11.13",
    "drizzle-orm": "^0.42.0",
    "hono": "4.12.16",
    "i18next": "^25.3.2",
    "linkedom": "^0.18.10",
    "postal-mime": "^2.4.3",
    "resend": "^6.4.1",
    "ua-parser-js": "^2.0.3",
    "uuid": "^11.1.0"
  },
  "packageManager": "pnpm@9.15.9"
}
